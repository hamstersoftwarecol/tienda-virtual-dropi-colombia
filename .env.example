APP_NAME="NovaStore Colombia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="America/Bogota"
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (Desarrollo Local)
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/a/database.sqlite

# MySQL / MariaDB (Para Servidor cPanel / Producción)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cpaneluser_tiendavirtual
# DB_USERNAME=cpaneluser_dbuser
# DB_PASSWORD=TuPasswordSeguro123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.tudominio.com
MAIL_PORT=465
MAIL_USERNAME=notificaciones@tudominio.com
MAIL_PASSWORD=TuPasswordDeCorreo
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notificaciones@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Configuración Dropi.co
DROPI_API_URL="https://api.dropi.co/api/"
DROPI_AUTH_TOKEN=
DROPI_DEFAULT_CARRIER="Coordinadora"

VITE_APP_NAME="${APP_NAME}"
